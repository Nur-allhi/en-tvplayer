{
  "name": "en-tvplayer",
  "version": "3.2.0",
  "description": "Samsung Tizen TV IPTV Player — install on any Tizen 5.0+ TV",
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w player",
    "build": "npm run build -w player",
    "test": "npm run test -w player",
    "lint": "eslint player/src",
    "format": "prettier --write player/src",
    "format:check": "prettier --check player/src",
    "tizen": "cd tizen && node package.mjs",
    "proxy": "npm start -w proxy",
    "prepare": "husky"
  },
  "workspaces": [
    "player",
    "tizen",
    "proxy"
  ],
  "keywords": [
    "tizen",
    "iptv",
    "samsung",
    "tv",
    "player"
  ],
  "author": "Nur-allhi",
  "license": "MIT",
  "lint-staged": {
    "player/src/**/*.js": ["eslint --max-warnings=0", "prettier --write"],
    "player/src/**/*.css": ["prettier --write"]
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
